# Dependencies
node_modules/
.pnpm-store/

# Local browser session; contains Coupang cookies/login data.
.local-session/
.local-browser-test/

# Private order data and local databases
data/*
!data/.gitkeep
*.sqlite
*.sqlite-*
*.db
*.db-*

# Raw exports or temporary import files
*.csv

# Logs and debug dumps
logs/
*.log
debug.*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Environment variables and local secret overrides
.env
.env.*
!.env.example
config/*.local.json
config/*secret*.json

# Test/build artifacts
coverage/
test-results/
playwright-report/
dist/
build/
.cache/
tmp/

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Local backups made before edits (크롤러/설정 수정 전 백업)
*.bak
*.bak.*

# Live crawl config — 운영 환경값(ntfy 서버·토픽·토큰)이 들어간다.
# 새로 받으면 crawl-config.example.json 을 복사해서 쓸 것.
config/crawl-config.json
